# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_PROVIDER=openai            # openai | fake (deterministic rule-based agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE_ENABLED=true   # set false for models that reject a temperature parameter

# Opt-in live tests / demo (cost money)
RUN_LIVE_LLM_TESTS=0

# Research provider: mock (synthetic fixtures, default) | x (X API v2 recent search)
RESEARCH_PROVIDER=mock
X_BEARER_TOKEN=                # app-only bearer token (read-only); never commit a real one
X_MAX_RESULTS_PER_QUERY=10     # posts per request, 10..100 (10 is the API minimum)
X_MAX_QUERIES_PER_RUN=1        # X requests per run, including any retries
X_TIMEOUT_SECONDS=10

# Opt-in live X demo / tests (consume X API usage)
RUN_LIVE_X_TESTS=0
