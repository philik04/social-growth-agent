# Copy to .env (git-ignored) and fill in. Never commit real keys.
LLM_PROVIDER=openai            # openai | fake (deterministic rule-based agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE_ENABLED=true   # set false for models that reject a temperature parameter

# Opt-in live tests / demo (cost money)
RUN_LIVE_LLM_TESTS=0

# Research provider: mock (synthetic fixtures, default) | x (X API v2 recent search)
RESEARCH_PROVIDER=mock
X_BEARER_TOKEN=                # app-only bearer token (read-only); never commit a real one
X_MAX_RESULTS_PER_QUERY=10     # posts per request, 10..100 (10 is the API minimum)
X_MAX_QUERIES_PER_RUN=1        # X requests per run, including any retries
X_TIMEOUT_SECONDS=10

# Opt-in live X demo / tests (consume X API usage)
RUN_LIVE_X_TESTS=0

# Publishing (Phase 5). Approval never publishes; a publish request is a separate action
# and the worker makes the platform call. These credentials are deliberately NOT the
# read-only research token: an app-only bearer token cannot post at all.
PUBLISHER_PROVIDER=mock         # mock (posts nowhere, default) | x (real posts); never a silent fallback
X_PUBLISH_API_KEY=              # app consumer key; app user authentication must be "Read and write"
X_PUBLISH_API_SECRET=           # app consumer secret
X_PUBLISH_ACCESS_TOKEN=         # access token of the account that should post
X_PUBLISH_ACCESS_TOKEN_SECRET=  # its secret; never commit a real one
X_PUBLISH_TIMEOUT_SECONDS=10
PUBLISHER_POLL_SECONDS=5        # sga-publisher-worker poll interval
PUBLISHER_LEASE_SECONDS=60      # claim lease; at least 2 x X_PUBLISH_TIMEOUT_SECONDS + 5
PUBLISH_MAX_ATTEMPTS=3          # bounds automatic retries: not-sent failures, and 429s after their reset
PUBLISHER_EMBEDDED_WORKER=false # true runs a worker thread inside the API (local development only)
PUBLISH_MAX_SCHEDULE_DAYS=30
PUBLISH_PAST_TOLERANCE_SECONDS=300  # a scheduled_for this far in the past still means "now"

# Opt-in live publishing (creates ONE real post; both are required, credentials alone never suffice)
RUN_LIVE_X_PUBLISH_TESTS=0
CONFIRM_LIVE_X_PUBLISH=

# Persistence (Phase 4). docker-compose.yml provides a local server on port 5433.
DATABASE_URL=postgresql://sga@localhost:5433/sga
TEST_DATABASE_URL=              # e.g. postgresql://sga@localhost:5433/sga; DB tests skip without it (fail in CI)
PRICING_FILE=pricing.toml       # price list for cost estimates; prices are left blank by default
API_MAX_CONCURRENT_RUNS=2
